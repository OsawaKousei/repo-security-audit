NODE_VERSION=24.22.2
LOCAL_UID=1000
LOCAL_GID=1000
# Normal development uses the dev Cognito pool. Replace these dummy identifiers
# with your own dev Terraform outputs in .env.
AUTH_MODE=cognito
LOCAL_AUTH_BYPASS=false
COGNITO_ISSUER=https://cognito-idp.ap-northeast-1.amazonaws.com/ap-northeast-1_ExamplePool
COGNITO_CLIENT_ID=exampleclientid
COGNITO_LOGIN_URL=https://example-dev.auth.ap-northeast-1.amazoncognito.com
# Set the sub returned by scripts/create-dev-user.ts (not an email address).
ALLOWED_USER_SUB=
# success or failure (mock only)
MOCK_OUTCOME=success
OPENAI_API_KEY=your_key
# Worker execution: mock = full mock, audit = real GitHub/npm audit
AUDIT_MODE=mock
# mock = deterministic explanation, openai = real Responses API
AI_MODE=mock
# Set true only after enforcing the dedicated Project's $10 monthly hard limit.
OPENAI_HARD_LIMIT_CONFIRMED=false
# Optional token for public GitHub API rate limits (never permits private audits).
GITHUB_TOKEN=
